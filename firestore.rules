/**
 * @file Firestore Security Rules for the Outreach feature.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for outreach events,
 * where coordinators have full control over their events and participants have read-only access.
 * New converts are managed within the scope of their associated outreach event,
 * with access controlled by the coordinator and assigned reachers.
 *
 * Data Structure:
 * - /users/{userId}/outreach_events/{outreachId}: Outreach events created by a specific coordinator.
 *   - `coordinatorId` is redundantly stored in the document for easy validation.
 *   - `participantIds` is an array of user IDs who are participants in the outreach.
 * - /outreach_events/{outreachId}/new_converts/{newConvertId}: New converts associated with an outreach event.
 *   - `outreachId` is stored in the document for easy validation.
 *   - `assignedTo` is the `userId` of the reacher assigned to follow up with the new convert.
 *
 * Key Security Decisions:
 * - Coordinators can create, update, and delete outreach events they own.
 * - Participants have read-only access to outreach events they are participating in.
 * - Coordinators and assigned reachers can manage new converts within their outreach events.
 * - Listing outreach events is restricted to the coordinator.
 * - Listing new converts is restricted to participants of the outreach event.
 *
 * Denormalization for Authorization:
 * - The `coordinatorId` field within `outreach_events` documents and the `outreachId` field within
 *   `new_converts` documents eliminates the need for costly `get()` calls to verify ownership or association.
 * - The `participantIds` array denormalized on the `outreach_events` document is used to authorize
 *   listing and reading.
 *
 * Structural Segregation:
 * - Outreach events are nested under the coordinator's user ID (`/users/{userId}/outreach_events/{outreachId}`)
 *   to enforce ownership and simplify access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows coordinators to manage their outreach events.
     * @path /users/{userId}/outreach_events/{outreachId}
     * @allow (create) Coordinator creates a new outreach event with matching userId and coordinatorId.
     * @allow (update) Coordinator updates their outreach event.
     * @allow (delete) Coordinator deletes their outreach event.
     * @deny (create) Another user attempts to create an outreach event under someone else's userId.
     * @deny (update) Another user attempts to update an outreach event they don't own.
     * @deny (delete) Another user attempts to delete an outreach event they don't own.
     * @principle Enforces document ownership for writes and validates relational integrity.
     */
    match /users/{userId}/outreach_events/{outreachId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId)
                      && request.resource.data.coordinatorId == userId
                      && request.resource.data.id == outreachId;

      allow update: if isExistingOwner(userId)
                      && request.resource.data.coordinatorId == resource.data.coordinatorId
                      && request.resource.data.id == resource.data.id;

      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows participants to list new converts within outreach events.
     * @path outreach_events/{outreachId}/new_converts/{newConvertId}
     * @allow (get) Any participant can retrieve a new convert if the outreach event includes the participant.
     * @allow (create) The coordinator or a participant can create a new convert, with validation for outreachId and assignedTo.
     * @allow (update) The coordinator or assigned reacher can update a new convert.
     * @allow (delete) The coordinator can delete a new convert.
     * @deny (create) A non-participant attempts to create a new convert.
     * @deny (update) A non-coordinator/non-assigned reacher attempts to update a new convert.
     * @deny (delete) A non-coordinator attempts to delete a new convert.
     * @principle Restricts access to new converts based on outreach participation and assigned reachers.
     */
    match /outreach_events/{outreachId}/new_converts/{newConvertId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant(outreachId) {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)/outreach_events/$(outreachId))
                || get(/databases/$(database)/documents/users/$(request.auth.uid)/outreach_events/$(outreachId)).data.participantIds.hasAny([request.auth.uid]);
      }

      function isAssignedReacher(assignedTo) {
        return isSignedIn() && request.auth.uid == assignedTo;
      }

      function isCoordinator(outreachId) {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)/outreach_events/$(outreachId)).data.coordinatorId == request.auth.uid;
      }

      function isExistingDocument() {
        return resource != null;
      }

      allow get: if isParticipant(outreachId);
      allow list: if isParticipant(outreachId);

      allow create: if isSignedIn()
                      && request.resource.data.outreachId == outreachId
                      && (isCoordinator(outreachId) || isParticipant(outreachId))
                      && (request.resource.data.assignedTo != null);

      allow update: if isExistingDocument()
                      && request.resource.data.outreachId == resource.data.outreachId
                      && (isCoordinator(outreachId) || isAssignedReacher(resource.data.assignedTo));

      allow delete: if isExistingDocument() && isCoordinator(outreachId);
    }
  }
}