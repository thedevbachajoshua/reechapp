/**
 * @file Firestore Security Rules for the Outreach feature.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for outreach events,
 * where coordinators have full control over their events and participants have read-only access.
 * New converts are managed within the scope of their associated outreach event,
 * with access controlled by the coordinator and assigned reachers.
 *
 * Data Structure:
 * - /outreaches/{outreachId}: Outreach events.
 *   - `coordinatorId` is the user ID of the event creator.
 *   - `participantIds` is an array of user IDs who are participants.
 * - /outreaches/{outreachId}/new_converts/{newConvertId}: New converts for an event.
 *   - `assignedTo` is the `userId` of the reacher assigned to follow up.
 *
 * Key Security Decisions:
 * - Coordinators can create, update, and delete outreach events they own.
 * - Participants have read-only access to outreach events they are part of.
 * - Coordinators and assigned reachers can manage new converts within their outreach events.
 * - Listing outreach events is restricted to coordinators and participants.
 * - Listing new converts is restricted to participants of the outreach event.
 *
 * Denormalization for Authorization:
 * - The `coordinatorId` and `participantIds` fields within `outreaches` documents and the `assignedTo` field within
 *   `new_converts` documents eliminate the need for costly `get()` calls to verify ownership or association.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /outreaches/{outreachId} {
      function isParticipant() {
        return resource.data.participantIds.hasAny([request.auth.uid]);
      }
      
      function isCoordinator() {
        return isOwner(resource.data.coordinatorId);
      }

      allow read: if isSignedIn() && (isCoordinator() || isParticipant());
      allow list: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.coordinatorId == request.auth.uid;

      allow update, delete: if isSignedIn() && isCoordinator();
    }

    match /outreaches/{outreachId}/new_converts/{newConvertId} {
      function getOutreach() {
        return get(/databases/$(database)/documents/outreaches/$(outreachId));
      }

      function isOutreachParticipant() {
        let outreach = getOutreach();
        return outreach.data.participantIds.hasAny([request.auth.uid]);
      }
      
      function isOutreachCoordinator() {
        let outreach = getOutreach();
        return outreach.data.coordinatorId == request.auth.uid;
      }

      function isAssignedReacher() {
        return resource.data.assignedTo == request.auth.uid;
      }

      allow read, list: if isSignedIn() && (isOutreachCoordinator() || isOutreachParticipant());
      
      allow create: if isSignedIn() && (isOutreachCoordinator() || isOutreachParticipant());

      allow update: if isSignedIn() && (isOutreachCoordinator() || isAssignedReacher());

      allow delete: if isSignedIn() && isOutreachCoordinator();
    }
  }
}
