/**
 * @file Firestore Security Rules for the Outreach feature with role-based access.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership and role-based model.
 * Supervisors have broad permissions to manage outreaches and users.
 * Reachers have limited permissions focused on their assigned tasks.
 *
 * Data Structure:
 * - /users/{userId}: User profile documents, containing a 'role' field ('Supervisor' or 'Reacher').
 * - /outreaches/{outreachId}: Outreach events.
 *   - `coordinatorId` is the user ID of the event creator (a Supervisor).
 *   - `participantIds` is an array of user IDs of assigned Reachers.
 * - /outreaches/{outreachId}/new_converts/{newConvertId}: New converts for an event.
 *   - `assignedTo` is the `userId` of the reacher assigned to follow up.
 *
 * Key Security Decisions:
 * - User profile data is readable by any authenticated user, but only writable by the user themselves.
 *   The 'role' field cannot be changed by the user after it has been set.
 * - Supervisors can create, read, update, and delete any outreach event.
 * - Reachers can only read outreach events they are a participant in.
 * - Supervisors can manage new converts in any outreach.
 * - Reachers can create new converts and update converts assigned to them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isSupervisor() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'Supervisor';
    }

    function isReacher() {
        return isSignedIn() && getUserData(request.auth.uid).role == 'Reacher';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && !exists(/databases/$(database)/documents/users/$(userId));
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
    }

    match /outreaches/{outreachId} {
      function isParticipant() {
        return isSignedIn() && resource.data.participantIds.hasAny([request.auth.uid]);
      }

      allow read: if isSupervisor() || isParticipant();
      allow list: if isSignedIn(); // Filtered on the client

      allow create: if isSupervisor();

      allow update, delete: if isSupervisor();
    }

    match /outreaches/{outreachId}/new_converts/{newConvertId} {
      function isOutreachParticipant() {
          let outreach = get(/databases/$(database)/documents/outreaches/$(outreachId));
          return isSignedIn() && outreach.data.participantIds.hasAny([request.auth.uid]);
      }

      function isAssignedReacher() {
        return isSignedIn() && resource.data.assignedTo == request.auth.uid;
      }

      allow read, list: if isSupervisor() || isOutreachParticipant();
      
      allow create: if isSupervisor() || isOutreachParticipant();

      allow update: if isSupervisor() || isAssignedReacher();

      allow delete: if isSupervisor();
    }
  }
}
